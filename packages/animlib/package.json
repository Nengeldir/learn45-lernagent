{
  "name": "@l45/animlib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pinned OwlYouNeed animlib runtime for Learn45 explanation lessons",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
