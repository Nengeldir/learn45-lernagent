    "@gltf-transform/extensions": "^4.5.1",
    "acorn": "^8.15.0",
    "color-string": "^2.1.4",
    "earcut": "^3.2.4",
    "mathjax-full": "3.2.2",
    "quickjs-emscripten": "0.32.0",
    "svg-pathdata": "^8.0.0"
  },
  "devDependencies": {
    "@types/color-string": "^1.5.5",
    "@types/earcut": "^3.0.0",
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.3"
  }
