# Copy to backend/.env (never commit .env).
# Without a provider the app runs in simulation mode: prepared lessons, scripted coach, keyword judging.

# anthropic | openai | none
MODEL_PROVIDER=none

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Chat replies, hints and judging
ANTHROPIC_MODEL=claude-haiku-5-5
# Planner agent and lesson generator (tool use, low effort). Only Anthropic runs the planner;
# with openai or none the rules plan alone.
ANTHROPIC_PLANNER_MODEL=claude-opus-5-5

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Timeout per model call in milliseconds; on timeout the app uses prepared content
MODEL_TIMEOUT_MS=8000

# Planner limits in milliseconds: whole run and each model call (6 steps at most)
PLANNER_TOTAL_MS=45000
PLANNER_CALL_MS=20000

# Where the learner workspaces live (default: backend/var/learners, not in git)
# LEARNER_DIR=

PORT=8787

# Optional: regenerate the derivative lesson with paid German speech.
# The checked-in lesson works without a key. Run npm run video:build after configuring.
# local uses macOS say (Anna) and ffmpeg; elevenlabs works on any platform.
VIDEO_SPEECH_PROVIDER=local
VIDEO_LOCAL_VOICE=Anna
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
